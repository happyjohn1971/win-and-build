# Configure these in the hosting service's secret/environment settings.
# Never place real credentials in dist/ or commit an .env file.
BASE_URL=http://localhost:4174
AUTH0_ISSUER_BASE_URL=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
SESSION_SECRET=
PORT=4174
# Production: NODE_ENV=production, HOST=0.0.0.0 and HTTPS BASE_URL.
# Set TRUST_PROXY_HOPS only to match the deployment's known trusted proxy count.
# Optional: Postgres connection string. When set, competitions are stored in the
# database (table created automatically). When unset, competitions.json under
# ADMIN_DATA_DIR (default server/data/) is used. On Render free web services the
# filesystem is ephemeral — attach a Postgres database and set DATABASE_URL so
# admin edits survive restarts.
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# ADMIN_DATA_DIR=
# ADMIN_USER_IDS=auth0|...
